{
  "name": "@shop-counter/server",
  "version": "0.1.0",
  "private": true,
  "description": "Shop Counter: an honest electronics shop assistant for Alexa+, served as an MCP server over Streamable HTTP.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx --conditions=shelf-source src/http.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/http.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "node scripts/build.mjs && tsx --conditions=shelf-source check.mjs",
    "package": "node scripts/build.mjs && rm -f dist/function.zip && cd dist && zip -q -9 function.zip lambda.mjs $(ls view.html 2>/dev/null) && ls -la function.zip"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1142.0",
    "@aws-sdk/lib-dynamodb": "3.1142.0",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "shelf-to-alexa": "0.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
